---
// 1200×630 link-preview card. Not linked anywhere; `npm run assets` screenshots it
// to public/og.jpg, which every page references via og:image.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import figure from '../assets/hero/yogesh-tone.png';
import { person } from '../data/profile';

const host = (Astro.site ?? new URL('https://yo9esh.tech')).host;
const N = 48;
const rays = Array.from({ length: N }, (_, i) => {
  const a = (i / N) * Math.PI * 2, w = (Math.PI * 2) / N / (i % 3 ? 4.5 : 2.2);
  const pt = (ang: number, r: number) => `${(420 + Math.cos(ang) * r).toFixed(1)},${(300 + Math.sin(ang) * r).toFixed(1)}`;
  return `M${pt(a - w, 60)}L${pt(a, 1100)}L${pt(a + w, 60)}Z`;
}).join('');
---
<Base title={`${person.name} · link preview`} bare noindex>
  <div class="card">
    <svg class="rays" viewBox="0 0 1200 630" aria-hidden="true"><path d={rays} /></svg>
    <div class="slab" aria-hidden="true"></div>
    <Image src={figure} alt="" height={600} class="fig" loading="eager" />
    <div class="copy">
      <p class="kana" lang="ja">ヨゲシュ・クマール</p>
      <p class="name">YO<span>9</span>ESH</p>
      <p class="role">{person.name} · {person.role}</p>
      <p class="sub">SDE intern at SystemStar · 4× hackathon winner · SIH ’24 finalist</p>
    </div>
    <p class="host">{host}</p>
  </div>
</Base>

<style>
  :global(html), :global(body) { margin: 0; width: 1200px; height: 630px; overflow: hidden; background: #121110; }
  .card { position: relative; width: 1200px; height: 630px; overflow: hidden; background: #121110; color: #f3ece0; }
  .rays { position: absolute; inset: 0; width: 100%; height: 100%; fill: #e1261c; opacity: .22; }
  .slab {
    position: absolute; top: 0; right: 0; width: 470px; height: 100%;
    background: repeating-linear-gradient(115deg, transparent 0 22px, rgba(0,0,0,.08) 22px 24px), #e1261c;
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);
  }
  .fig { position: absolute; right: 90px; bottom: 0; height: 600px; width: auto; filter: drop-shadow(8px 0 0 #121110); }
  .copy { position: absolute; left: 70px; top: 110px; width: 720px; }
  .kana { margin: 0 0 12px; font: 900 26px/1 var(--jp); letter-spacing: .4em; color: #e1261c; }
  .name { margin: 0; font: 400 200px/.85 var(--display); letter-spacing: .02em; text-shadow: 9px 9px 0 #e1261c; }
  .name span { color: #e1261c; text-shadow: 9px 9px 0 #f3ece0; }
  .role { margin: 34px 0 0; font: 600 32px/1.2 var(--sans); }
  .sub { margin: 10px 0 0; font: 400 21px/1.4 var(--sans); color: #b9ae9f; white-space: nowrap; }
  .host { position: absolute; left: 70px; bottom: 44px; margin: 0; font: 600 24px/1 var(--mono); color: #e1261c; }
</style>
