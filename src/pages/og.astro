---
// 1200×630 link-preview card. Not linked anywhere; `npm run assets` screenshots it
// to public/og.jpg, which every page references via og:image.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import avatar from '../assets/photos/avatar-blue.png';
import { person } from '../data/profile';

const host = (Astro.site ?? new URL('https://yo9esh.tech')).host;
---
<Base title={`${person.name} · link preview`} bare noindex>
  <div class="card">
    <div class="copy">
      <p class="mark">yo<span>9</span>esh</p>
      <h1>I design how the <em>pieces</em> connect.</h1>
      <p class="role">{person.name} · {person.role}</p>
      <p class="sub">SDE intern at SystemStar · 4× hackathon winner · SIH ’24 finalist</p>
    </div>
    <div class="side">
      <Image src={avatar} alt="" width={460} height={460} class="avatar" loading="eager" />
      <div class="links" aria-hidden="true">
        <i></i><b></b><i class="hot"></i><b></b><i></i>
      </div>
    </div>
    <p class="host">{host}</p>
  </div>
</Base>

<style>
  :global(html), :global(body) { margin: 0; width: 1200px; height: 630px; overflow: hidden; }
  .card {
    /* fixed light palette so the card looks the same everywhere it's shared */
    --ink: #1c1915; --ink-2: #4a443b; --muted: #7a7266; --line: #e6dfd1; --accent: #e3a008; --accent-ink: #8a5a00;
    position: relative; box-sizing: border-box; width: 1200px; height: 630px; padding: 64px 72px;
    display: grid; grid-template-columns: 1fr 300px; gap: 48px; align-items: center;
    color: var(--ink);
    background:
      radial-gradient(circle at 1px 1px, var(--line) 1.2px, transparent 0) 0 0 / 22px 22px,
      #faf7f0;
  }
  .copy { align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
  .mark { position: absolute; top: 56px; left: 72px; margin: 0; font: 600 26px/1 var(--mono); letter-spacing: -0.02em; }
  .mark span { color: var(--accent-ink); }
  h1 { font-family: var(--serif); font-weight: 400; font-size: 92px; line-height: 0.98; letter-spacing: -0.015em; margin: 0 0 30px; }
  h1 em { color: var(--accent-ink); }
  .role { margin: 0; font: 600 30px/1.3 var(--sans); letter-spacing: -0.01em; }
  .sub { margin: 8px 0 0; font: 400 22px/1.4 var(--sans); color: var(--ink-2); }
  .side { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .avatar { width: 260px; height: 260px; border-radius: 50%; object-fit: cover; border: 5px solid var(--accent); box-shadow: 0 24px 48px -24px rgba(28,25,21,.45); }
  /* the site's diagram motif: nodes joined by dashed links, one lit */
  .links { display: flex; align-items: center; }
  .links i { width: 16px; height: 16px; border-radius: 4px; border: 2px solid var(--ink-2); background: #fff; }
  .links i.hot { background: var(--accent); border-color: var(--accent); border-radius: 50%; }
  .links b { width: 46px; border-top: 2px dashed var(--muted); }
  .host { position: absolute; right: 72px; top: 56px; margin: 0; font: 500 24px/1 var(--mono); color: var(--accent-ink); }
</style>
