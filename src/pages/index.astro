---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SystemCard from '../components/SystemCard.astro';
import { person, systems, builds, recognition, moments, toolbelt, learning } from '../data/profile';
import { getStars } from '../lib/github';

import sih from '../assets/photos/sih-2024.png';
import ideatex from '../assets/photos/ideatex-2025-crop.png';
import esummit from '../assets/photos/esummit-2025.png';
import tcs from '../assets/photos/tcs-2026.png';
import portrait from '../assets/photos/portrait.png';

const photos = { sih, ideatex, esummit, tcs } as const;
const stars = await getStars('Coden-inja/alchEmaiLyst', 42);
const featured = systems.filter((s) => s.featured);
const more = systems.filter((s) => !s.featured);
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <Hero />

  <section id="work" class="wrap">
    <div class="section-head">
      <h2>Selected systems</h2>
      <span class="count">{String(systems.length).padStart(2, '0')} case studies</span>
    </div>
    {featured.map((s, i) => <SystemCard system={s} index={i} stars={stars} />)}

    {more.length > 0 && (
      <details class="more">
        <summary>
          <span class="open-label">View {more.length} more systems</span>
          <span class="close-label">Show fewer</span>
          <span class="names muted">{more.map((s) => (s.name ?? s.title).split(/ · |,/)[0]).join(' · ')}</span>
        </summary>
        {more.map((s, i) => <SystemCard system={s} index={featured.length + i} stars={stars} />)}
      </details>
    )}

    <div class="builds">
      <p class="eyebrow">Also built</p>
      <ul>
        {builds.map((b) => (
          <li>
            <a href={b.href}><strong>{b.name}</strong> <span aria-hidden="true">↗</span></a>
            <span>{b.what}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="notes" class="wrap">
    <div class="section-head">
      <h2>Systems notebook</h2>
      <span class="count">notes from the build</span>
    </div>
    <div class="notes">
      {notes.map((n) => (
        <a class="note" href={`/notes/${n.id}`}>
          <span class="chip">{n.data.tag}</span>
          <h3>{n.data.title}</h3>
          <p>{n.data.description}</p>
          <span class="read mono">Read →</span>
        </a>
      ))}
    </div>
  </section>

  <section id="moments" class="wrap">
    <div class="section-head">
      <h2>On the podium, in the room</h2>
      <span class="count">20+ hackathons</span>
    </div>
    <div class="moments">
      {moments.map((m, i) => (
        <figure class:list={[{ tall: i === 0 }]}>
          <Image
            src={photos[m.photo as keyof typeof photos]}
            alt={`${m.caption}: ${m.sub}`}
            widths={[480, 800, 1200]}
            sizes="(max-width: 720px) 100vw, 50vw"
            style={`object-position:${m.position}`}
            loading="lazy"
          />
          <figcaption><strong>{m.caption}</strong><span>{m.sub}</span></figcaption>
        </figure>
      ))}
    </div>

    <table class="recog">
      <caption class="eyebrow">Recognition</caption>
      <tbody>
        {recognition.map((r) => (
          <tr>
            <td class="mono date">{r.date}</td>
            <td><strong>{r.result}</strong> · {r.event}{r.note && <span class="muted"> · {r.note}</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section id="tools" class="wrap">
    <div class="section-head">
      <h2>Few tools, all the way down</h2>
      <span class="count">depth over breadth</span>
    </div>
    <dl class="tools">
      {toolbelt.map((t) => (
        <div><dt class="mono">{t.tool}</dt><dd>{t.proof.split('`').map((part, i) => i % 2 ? <code>{part}</code> : part)}</dd></div>
      ))}
    </dl>
    <p class="learning"><span class="dot" aria-hidden="true"></span>{learning}</p>
  </section>

  <section id="about" class="wrap about">
    <Image src={portrait} alt="Yogesh in a yellow kurta at an old Kolkata gate, smiling" widths={[480, 800]} sizes="(max-width: 820px) 100vw, 40vw" class="portrait" />
    <div>
      <p class="eyebrow">About</p>
      <h2>From Gaya to Kolkata, one shipped thing at a time.</h2>
      <p>I’m a Computer Science undergrad at Heritage Institute of Technology, Kolkata, and a software engineering intern at SystemStar Infotech. I like the unglamorous middle of a product: how 4K 360° video starts playing without the wait, how an LLM gets grounded in real data, how a stack runs when the hardware says it can’t.</p>
      <p>How I work: <strong>I show work early.</strong> I got my internship by building a mock before the interview, not after. <a href="/notes/ship-before-the-interview">Here’s that story.</a></p>
      <p>I’ve been through 20+ hackathons, from a two-hour build to the SIH Grand Finale, and I ran AlchEmaiLyst as an open-source project in GSSoC ’25.</p>
    </div>
  </section>

  <section id="contact" class="wrap contact">
    <p class="eyebrow">Contact</p>
    <h2>Have a system that needs its pieces connected?</h2>
    <a class="mail" href={`mailto:${person.email}`}>{person.email}</a>
    <ul class="social">
      <li><a href={person.links.github}>GitHub</a></li>
      <li><a href={person.links.linkedin}>LinkedIn</a></li>
      <li><a href={person.links.x}>X</a></li>
      <li><a href={person.links.peerlist}>Peerlist</a></li>
      <li><a href="/yogesh-kumar-resume.pdf">Resume PDF</a></li>
    </ul>
  </section>
</Base>

<style>
  .more { margin-top: 32px; }
  .more summary {
    list-style: none; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
    padding: 20px; border: 1px dashed var(--line); border-radius: var(--radius);
    font-weight: 500; transition: border-color .15s, background .15s;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary:hover { border-color: var(--accent); background: var(--surface); }
  .more summary .names { font-family: var(--mono); font-size: 0.72rem; font-weight: 400; }
  .more .close-label, .more[open] .open-label, .more[open] .names { display: none; }
  .more[open] .close-label { display: inline; }
  .more[open] summary { margin-bottom: 8px; }
  .builds { margin-top: 56px; }
  .builds ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 40px; }
  .builds li { display: flex; flex-direction: column; gap: 2px; padding: 14px 0; border-top: 1px solid var(--line); font-size: 0.92rem; color: var(--ink-2); }
  .builds a { text-decoration: none; color: var(--ink); }
  .builds a:hover strong { color: var(--accent-ink); }
  @media (max-width: 720px) { .builds ul { grid-template-columns: 1fr; } }

  .notes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  @media (max-width: 720px) { .notes { grid-template-columns: 1fr; } }
  .note {
    display: flex; flex-direction: column; gap: 12px; align-items: flex-start;
    padding: 28px; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); text-decoration: none; transition: border-color .15s, transform .15s;
  }
  .note:hover { border-color: var(--accent); transform: translateY(-2px); color: inherit; }
  .note h3 { font-size: 1.7rem; }
  .note p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  .note .read { font-size: 0.78rem; color: var(--accent-ink); margin-top: auto; }

  .moments { display: grid; grid-template-columns: 1.1fr 1fr 1fr; grid-auto-rows: 220px; gap: 12px; }
  .moments figure { position: relative; margin: 0; border-radius: var(--radius); overflow: hidden; background: var(--line); }
  .moments figure.tall { grid-row: span 2; }
  .moments img { width: 100%; height: 100%; object-fit: cover; }
  .moments figcaption {
    position: absolute; inset: auto 0 0 0; padding: 32px 14px 12px; color: #fff;
    background: linear-gradient(transparent, rgba(0,0,0,.72));
    display: flex; flex-direction: column; font-size: 0.75rem; line-height: 1.35;
  }
  .moments figcaption strong { font-size: 0.92rem; }
  .moments figure:nth-child(4) { grid-column: span 2; }
  @media (max-width: 720px) {
    .moments { grid-template-columns: 1fr 1fr; grid-auto-rows: 180px; }
    .moments figure.tall { grid-column: span 2; grid-row: span 2; }
    .moments figure:nth-child(4) { grid-column: span 2; }
  }

  .recog { width: 100%; border-collapse: collapse; margin-top: 40px; font-size: 0.95rem; }
  .recog caption { text-align: left; margin-bottom: 12px; }
  .recog td { padding: 12px 0; border-top: 1px solid var(--line); vertical-align: top; }
  .recog .date { width: 7.5em; color: var(--muted); font-size: 0.8rem; padding-top: 15px; }
  @media (max-width: 560px) { .recog tr { display: grid; } .recog .date { border-top: 1px solid var(--line); padding-bottom: 0; } .recog td + td { border-top: 0; padding-top: 4px; } }

  .tools { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 40px; margin: 0; }
  .tools div { display: grid; grid-template-columns: 11rem 1fr; gap: 16px; padding: 14px 0; border-top: 1px solid var(--line); }
  .tools dt { font-size: 0.85rem; font-weight: 600; }
  .tools dd { margin: 0; font-size: 0.92rem; color: var(--ink-2); }
  .tools code { font-family: var(--mono); font-size: 0.82em; background: var(--accent-soft); padding: 1px 5px; border-radius: 4px; }
  @media (max-width: 900px) { .tools { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .tools div { grid-template-columns: 1fr; gap: 4px; } }
  .learning { display: flex; gap: 12px; align-items: baseline; margin: 32px 0 0; padding: 16px 20px; border-radius: var(--radius); background: var(--accent-soft); color: var(--ink-2); font-size: 0.95rem; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: pulse 2s infinite; }
  @keyframes pulse { 50% { opacity: .3; } }

  .about { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  .about h2 { margin: 12px 0 20px; }
  .about p { color: var(--ink-2); max-width: 36em; }
  .portrait { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: var(--radius); }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } .portrait { max-width: 420px; } }

  .contact { text-align: center; padding-bottom: clamp(80px, 12vw, 140px); }
  .contact h2 { max-width: 16em; margin: 16px auto 28px; font-size: clamp(2.2rem, 6vw, 3.8rem); }
  .mail { font-family: var(--serif); font-style: italic; font-size: clamp(1.4rem, 4.5vw, 2.2rem); color: var(--accent-ink); word-break: break-all; }
  .social { list-style: none; padding: 0; margin: 32px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 24px; font-size: 0.92rem; }
</style>
