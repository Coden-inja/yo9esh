---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SystemCard from '../components/SystemCard.astro';
import { person, systems, play, story } from '../data/profile';
import { getStars } from '../lib/github';
import { icon } from '../lib/icons';

import sih from '../assets/photos/sih-2024.png';
import ideatex from '../assets/photos/ideatex-2025-crop.png';
import esummit from '../assets/photos/esummit-2025.png';
import tcs from '../assets/photos/tcs-2026.png';

const photos = { sih, ideatex, esummit, tcs } as const;
const stars = await getStars('Coden-inja/alchEmaiLyst', 42);
const featured = systems.filter((s) => s.featured);
const more = systems.filter((s) => !s.featured);
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <Hero />

  <section id="work" class="wrap">
    <div class="section-head">
      <h2>Things I’ve built</h2>
      <span class="count">{featured.length} of {systems.length}</span>
    </div>
    {featured.map((s, i) => <SystemCard system={s} index={i} stars={stars} />)}

    {more.length > 0 && (
      <details class="more">
        <summary>
          <span class="open-label">See {more.length} more projects</span>
          <span class="close-label">Show fewer</span>
          <span class="names muted">{more.map((s) => (s.name ?? s.title).split(/ · |,/)[0]).join(' · ')}</span>
        </summary>
        {more.map((s, i) => <SystemCard system={s} index={featured.length + i} stars={stars} />)}
      </details>
    )}
  </section>

  <section id="play" class="wrap">
    <div class="section-head">
      <h2>Play with these</h2>
      <span class="count">open in your browser</span>
    </div>
    <ul class="play">
      {play.map((p) => (
        <li>
          <a href={p.href}>
            <span class="ico" set:html={icon(p.icon)} />
            <span class="txt"><strong>{p.name}</strong><span>{p.what}</span></span>
            <span class="go mono" aria-hidden="true">Open ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="story" class="wrap">
    <div class="section-head">
      <h2>How I got here</h2>
      <span class="count">from {person.location.split('· from ')[1]}</span>
    </div>
    <ol class="story">
      {story.map((e) => (
        <li class:list={[{ now: e.when === 'Now' }]}>
          <span class="when mono">{e.when}</span>
          <div class="body">
            <p>
              {e.text}
              {e.link && <> <a href={e.link.href}>{e.link.label} →</a></>}
            </p>
            {e.photo && (
              <figure>
                <Image
                  src={photos[e.photo as keyof typeof photos]}
                  alt={e.caption ?? ''}
                  widths={[360, 720]}
                  sizes="(max-width: 720px) 100vw, 360px"
                  loading="lazy"
                />
                <figcaption>{e.caption}</figcaption>
              </figure>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="writing" class="wrap">
    <div class="section-head">
      <h2>Writing</h2>
      <span class="count">from LinkedIn</span>
    </div>
    <div class="notes">
      {notes.map((n) => (
        <a class="note" href={`/notes/${n.id}`}>
          <h3>{n.data.title}</h3>
          <p>{n.data.description}</p>
          <span class="read mono">Read →</span>
        </a>
      ))}
    </div>
  </section>

  <section id="contact" class="wrap contact">
    <p class="eyebrow">Say hi</p>
    <h2>Building something? I’d love to hear about it.</h2>
    <a class="mail" href={`mailto:${person.email}`}>{person.email}</a>
    <ul class="social">
      <li><a href={person.links.github}>GitHub</a></li>
      <li><a href={person.links.linkedin}>LinkedIn</a></li>
      <li><a href={person.links.x}>X</a></li>
      <li><a href={person.links.peerlist}>Peerlist</a></li>
      <li><a href="/yogesh-kumar-resume.pdf">Resume PDF</a></li>
    </ul>
  </section>
</Base>

<style>
  .more { margin-top: 28px; }
  .more summary {
    list-style: none; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
    padding: 18px; border: 1px dashed var(--line); border-radius: var(--radius);
    font-weight: 500; transition: border-color .15s, background .15s;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary:hover { border-color: var(--accent); background: var(--surface); }
  .more summary .names { font-family: var(--mono); font-size: 0.72rem; font-weight: 400; }
  .more .close-label, .more[open] .open-label, .more[open] .names { display: none; }
  .more[open] .close-label { display: inline; }
  .more[open] summary { margin-bottom: 8px; }

  .play { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
  .play a {
    display: flex; align-items: center; gap: 14px; height: 100%; box-sizing: border-box;
    padding: 16px 18px; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); text-decoration: none; color: inherit;
    transition: border-color .15s, transform .15s;
  }
  .play a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .play .ico { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; background: var(--bg); color: var(--ink-2); }
  .play .ico :global(svg) { width: 22px; height: 22px; }
  .play .txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .play strong { font-size: 0.98rem; }
  .play .txt span { font-size: 0.85rem; color: var(--muted); line-height: 1.4; }
  .play .go { margin-left: auto; flex: none; font-size: 0.72rem; color: var(--accent-ink); }
  @media (max-width: 420px) { .play { grid-template-columns: 1fr; } .play .go { display: none; } }

  .story { list-style: none; margin: 0; padding: 0; position: relative; }
  .story::before { content: ''; position: absolute; left: 9.5rem; top: 8px; bottom: 8px; border-left: 1.5px dashed var(--line); }
  .story li { display: grid; grid-template-columns: 9.5rem 1fr; gap: 0 28px; padding: 0 0 34px; position: relative; }
  .story li::before {
    content: ''; position: absolute; left: calc(9.5rem - 5px); top: 7px;
    width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 2px solid var(--muted);
  }
  .story li.now::before { background: var(--accent); border-color: var(--accent); }
  .when { font-size: 0.78rem; color: var(--muted); padding-top: 3px; padding-right: 16px; }
  /* text beside its photo on wide screens, photo below on phones */
  .body { max-width: 56em; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0 28px; align-items: start; }
  .body p { margin: 0; color: var(--ink-2); max-width: 36em; }
  .story li.now .body p { color: var(--ink); font-size: 1.08rem; }
  .body figure { margin: 2px 0 0; width: 220px; }
  @media (max-width: 900px) { .body { grid-template-columns: 1fr; } .body figure { margin-top: 14px; width: min(100%, 320px); } }
  .body img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; border: 1px solid var(--line); }
  .body figcaption { margin-top: 6px; font-size: 0.75rem; color: var(--muted); }
  @media (max-width: 640px) {
    .story::before { left: 4px; }
    .story li { grid-template-columns: 1fr; padding-left: 26px; }
    .story li::before { left: 0; }
    .when { padding: 0 0 4px; }
  }

  .notes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (max-width: 720px) { .notes { grid-template-columns: 1fr; } }
  .note {
    display: flex; flex-direction: column; gap: 10px; align-items: flex-start;
    padding: 24px; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); text-decoration: none; transition: border-color .15s, transform .15s;
  }
  .note:hover { border-color: var(--accent); transform: translateY(-2px); color: inherit; }
  .note h3 { font-size: 1.6rem; }
  .note p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  .note .read { font-size: 0.78rem; color: var(--accent-ink); margin-top: auto; }

  .contact { text-align: center; padding-bottom: clamp(48px, 7vw, 72px); }
  .contact h2 { max-width: 16em; margin: 16px auto 24px; font-size: clamp(2.1rem, 5.5vw, 3.4rem); }
  /* sans, not the serif: Instrument Serif draws 1 and l almost identically */
  .mail { font-family: var(--sans); font-weight: 500; letter-spacing: -0.01em; font-size: clamp(1.25rem, 4vw, 1.9rem); color: var(--accent-ink); overflow-wrap: anywhere; }
  .social { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 24px; font-size: 0.92rem; }
</style>
