---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ColdOpen from '../components/ColdOpen.astro';
import AnimeHero from '../components/AnimeHero.astro';
import Marquee from '../components/Marquee.astro';
import EpTitle from '../components/EpTitle.astro';
import CharacterCard from '../components/CharacterCard.astro';
import Episodes from '../components/Episodes.astro';
import SideQuests from '../components/SideQuests.astro';
import ToBeContinued from '../components/ToBeContinued.astro';
import Player from '../components/Player.astro';
import Keys from '../components/Keys.astro';
import Motion from '../components/Motion.astro';
import { systems } from '../data/profile';
import { getStars } from '../lib/github';

const stars = await getStars('Coden-inja/alchEmaiLyst', 42);
const featured = systems.filter((s) => s.featured);
const more = systems.filter((s) => !s.featured);
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <ColdOpen />
  <AnimeHero />
  <Marquee />

  <section id="work" class="wrap" data-jump="1">
    <EpTitle ep="01" title="The Builds" jp="作品" sub={`${systems.length} systems · ${featured.length} featured`} />
    {featured.map((s, i) => <CharacterCard system={s} index={i} stars={stars} />)}
    {more.length > 0 && (
      <details class="more">
        <summary>
          <span class="open-label">Unlock {more.length} more builds</span>
          <span class="close-label">Hide them again</span>
          <span class="names mono">{more.map((s) => (s.name ?? s.title).split(/ · |,/)[0]).join(' · ')}</span>
        </summary>
        {more.map((s, i) => <CharacterCard system={s} index={featured.length + i} stars={stars} />)}
      </details>
    )}
  </section>

  <section id="story" data-jump="2">
    <div class="wrap"><EpTitle ep="02" title="Origin Story" jp="物語" sub="seven episodes · keep scrolling →" compact /></div>
    <Episodes />
  </section>

  <section id="side" class="wrap" data-jump="3">
    <EpTitle ep="03" title="Side Quests" jp="寄り道" sub="things you can play with · press q w e r t" />
    <SideQuests />
  </section>

  <section id="notes" class="wrap" data-jump="4">
    <EpTitle ep="04" title="Field Notes" jp="記録" sub="from my LinkedIn" />
    <div class="chapters">
      {notes.map((n, i) => (
        <a class="chapter" href={`/notes/${n.id}`}>
          <span class="ch" aria-hidden="true">CH.{String(i + 1).padStart(2, '0')}</span>
          <h3>{n.data.title}</h3>
          <p>{n.data.description}</p>
          <span class="read mono">Read →</span>
        </a>
      ))}
    </div>
  </section>

  <section id="contact" class="wrap" data-jump="5">
    <ToBeContinued />
  </section>

  <Player />
  <Keys />
  <Motion />
</Base>

<style>
  section { scroll-margin-top: 20px; }
  #story { overflow: hidden; }
  /* desktop with motion: the story is one full screen, pinned while the strip scrolls sideways */
  @media (min-width: 900px) {
    :global(html.motion) #story {
      height: 100svh; box-sizing: border-box; padding: 76px 0 26px;
      display: flex; flex-direction: column; justify-content: center;
      --strip-h: calc(100svh - 76px - 26px - var(--title-h, 230px) - 28px);
    }
  }

  .more { margin-top: 8px; }
  .more summary {
    list-style: none; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
    padding: 20px; border: 2px dashed var(--ink); border-radius: 4px;
    font: 400 1.5rem/1 var(--display); letter-spacing: .04em; text-transform: uppercase;
    transition: background .15s, color .15s;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary:hover { background: var(--ink); color: var(--bg); }
  .more .names { font-size: .72rem; letter-spacing: .06em; text-transform: none; color: var(--muted); }
  .more summary:hover .names { color: inherit; opacity: .7; }
  .more .close-label, .more[open] .open-label, .more[open] .names { display: none; }
  .more[open] .close-label { display: inline; }
  .more[open] summary { margin-bottom: 40px; }

  .chapters { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  @media (max-width: 720px) { .chapters { grid-template-columns: 1fr; } }
  .chapter {
    position: relative; display: flex; flex-direction: column; gap: 10px; padding: 26px 26px 22px;
    text-decoration: none; color: var(--ink); background: var(--surface);
    border: 2px solid var(--ink); border-radius: 4px; box-shadow: 7px 7px 0 var(--ink);
    transition: transform .15s, box-shadow .15s;
  }
  .chapter:hover { transform: translate(-3px, -3px); box-shadow: 10px 10px 0 var(--accent); color: var(--ink); }
  .ch { font: 400 3rem/.9 var(--display); color: transparent; -webkit-text-stroke: 1.5px var(--accent); }
  .chapter h3 { margin: 0; font: 400 1.9rem/1 var(--display); text-transform: uppercase; letter-spacing: .01em; }
  .chapter p { margin: 0; color: var(--ink-2); font-size: .95rem; }
  .read { margin-top: auto; font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-ink); }
</style>
