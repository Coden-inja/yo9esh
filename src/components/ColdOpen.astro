---
// Anime title screen, shown on every visit to the home page (Base.astro adds `html.op`
// before first paint). "Press any key" is the user gesture browsers require for audio,
// so entering plays the OP sequence with synced hits and then starts the lo-fi.
// States: html.op (title screen) → .op-play (sequence) → .op-out (wipe) → .ready
const RAYS = 56;
const rays = Array.from({ length: RAYS }, (_, i) => {
  const a = (i / RAYS) * Math.PI * 2;
  const w = (Math.PI * 2) / RAYS / (i % 3 === 0 ? 2.2 : 4.5);
  const p = (ang: number, r: number) => `${(500 + Math.cos(ang) * r).toFixed(1)},${(500 + Math.sin(ang) * r).toFixed(1)}`;
  return `M${p(a - w, 90)} L${p(a, 760)} L${p(a + w, 90)} Z`;
});
---
<div class="cold" role="dialog" aria-modal="true" aria-label="Yogesh Kumar: title screen">
  <svg class="rays" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d={rays.join(' ')} />
  </svg>

  <!-- title screen -->
  <div class="halftone" aria-hidden="true"></div>
  <div class="gate">
    <p class="g-kana" lang="ja" aria-hidden="true">ヨゲシュ・クマール</p>
    <p class="g-title" aria-hidden="true">YO<span>9</span>ESH</p>
    <div class="press">
      <p class="g-cta mono" aria-hidden="true"><span class="on-keys">press any key</span><span class="on-touch">tap to start</span><i class="caret"></i></p>
      <button class="cap" type="button" data-start aria-label="Enter the site with sound">
        <span class="cap-top"><span class="cap-legend">ENTER</span><span class="cap-sub" aria-hidden="true">↵</span></span>
      </button>
    </div>
    <p class="g-sub mono"><button type="button" class="muted" data-start-muted>enter without sound <kbd>M</kbd></button></p>
  </div>

  <!-- OP sequence -->
  <p class="kana" aria-hidden="true">ヨゲシュ</p>
  <div class="flash" aria-hidden="true"></div>
  <div class="card" aria-hidden="true">
    <h1><span class="t1">YOGESH</span><span class="t2">KUMAR</span></h1>
    <p class="kana-sub">ヨゲシュ・クマール</p>
  </div>
  <p class="skip mono" aria-hidden="true">any key skips</p>
</div>

<script>
  import { audio, ready, whoosh, impact, click, setClicks } from '../lib/audio';
  import { play } from '../lib/lofi';

  const root = document.documentElement;
  const isDebug = new URLSearchParams(location.search).has('debug');
  const log = (...args: any[]) => { if (isDebug) console.log('[intro]', ...args); };

  let stage: 'gate' | 'play' | 'done' = 'gate';
  let timers: number[] = [];

  // Watchdog: armed only once the OP sequence starts (never while the title screen is
  // waiting for a key), and it keeps the visitor's sound choice.
  let watchdog = 0;

  function finish(withSound: boolean) {
    if (stage === 'done') return;
    stage = 'done';
    clearTimeout(watchdog);
    timers.forEach(clearTimeout);
    log('Finish called, transitioning to home');
    root.classList.add('op-out', 'ready');
    if (withSound) {
      play();
      // if the browser still hasn't let audio run, tell the player to ask for a tap
      setTimeout(() => { if (audio().state !== 'running') { log('audio still blocked'); dispatchEvent(new CustomEvent('audio:blocked')); } }, 600);
    }
    setTimeout(() => root.classList.remove('op', 'op-play', 'op-out'), 560);
  }

  function enter(withSound: boolean) {
    if (stage !== 'gate') return;
    stage = 'play';
    log('Enter called, withSound:', withSound);
    if (!withSound) setClicks(false);
    let started = false;
    const go = () => {
      if (started) return;
      started = true;
      root.classList.add('op-play');
      timers = [window.setTimeout(() => finish(withSound), 2700)];
      watchdog = window.setTimeout(() => { log('Watchdog: forcing finish'); finish(withSound); }, 4200);
    };
    if (!withSound) { go(); return; }
    // Sounds are triggered by the animations themselves (animationstart fires when each
    // CSS animation actually begins, after its delay), so every hit lands on its frame.
    const cue = (sel: string, name: string, fn: () => void) => {
      const el = document.querySelector(sel);
      if (!el) return;
      el.addEventListener('animationstart', (e) => {
        if ((e as AnimationEvent).animationName.includes(name)) fn();
      });
    };
    cue('.cold .kana', 'kana', () => whoosh(0, 0.5));
    cue('.cold .t1', 'slam', () => impact(0, 1));
    cue('.cold .t2', 'wipe', () => impact(0, 0.5));
    // The audio clock only starts after this gesture, so wait for it before rolling, but never
    // longer than 400 ms: if a browser keeps audio blocked, the intro still plays (silently).
    ready().then((c) => { log('audio', c.state); click(true); go(); }, (err) => { log('audio blocked', err); go(); });
    window.setTimeout(go, 400);
  }

  addEventListener('keydown', (e) => {
    if (!root.classList.contains('op') || e.ctrlKey || e.metaKey || e.altKey) return;
    if (['Tab', 'Shift'].includes(e.key)) return; // let keyboard users reach the buttons
    e.preventDefault();
    if (stage === 'gate') enter(e.key.toLowerCase() !== 'm');
    else if (stage === 'play') finish(root.classList.contains('op-play') && e.key.toLowerCase() !== 'm');
  }, true);
  document.querySelector('[data-start]')!.addEventListener('click', () => enter(true));
  document.querySelector('[data-start-muted]')!.addEventListener('click', (e) => { e.stopPropagation(); enter(false); });
  document.querySelector('.cold')!.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('button')) return;
    if (stage === 'gate') enter(true); else if (stage === 'play') finish(true);
  });
  if (!root.classList.contains('op')) {
    root.classList.add('ready');
  } else {
    (document.querySelector('[data-start]') as HTMLElement).focus({ preventScroll: true });
  }
</script>

<style>
  .cold { display: none; }
  :global(html.op) { overflow: hidden; }
  :global(html.op) .cold {
    position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; overflow: hidden;
    background: #121110; color: #f3ece0; clip-path: inset(0 0 0 0);
  }
  :global(html.op-out) .cold { clip-path: inset(0 0 100% 0); transition: clip-path .55s cubic-bezier(.7,0,.25,1); }

  /* ---- title screen ---- */
  .gate { position: relative; z-index: 2; text-align: center; padding: 16px; }
  :global(html.op-play) .gate { display: none; }
  .g-kana { margin: 0 0 10px; font: 900 clamp(.9rem, 2vw, 1.2rem)/1 var(--jp); letter-spacing: .5em; color: #e1261c; }
  .g-title { margin: 0; font: 400 clamp(5rem, 20vw, 15rem)/.85 var(--display); letter-spacing: .02em; text-shadow: 7px 7px 0 #e1261c; }
  .g-title span { color: #e1261c; text-shadow: 7px 7px 0 #f3ece0; }
  .g-role { margin: 18px 0 0; font-size: .78rem; letter-spacing: .32em; text-transform: uppercase; color: #b9ae9f; }

  /* the start button is a big mechanical keycap: skirt + dished top, presses down on any key */
  .press { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 30px; }
  .g-cta { margin: 0; font-size: .82rem; letter-spacing: .34em; text-transform: uppercase; color: #f3ece0; }
  .caret { display: inline-block; width: .55em; height: 1.05em; margin-left: .4em; vertical-align: -.15em; background: #e1261c; animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .cap {
    all: unset; cursor: pointer; position: relative; width: 200px; height: 86px;
    background: #2a2622; border-radius: 14px;
    box-shadow: 0 10px 0 #0a0908, 0 14px 22px rgba(0,0,0,.55), 0 0 0 2px #e1261c;
    transition: transform .07s, box-shadow .07s;
  }
  .cap-top {
    position: absolute; inset: 6px 10px 14px; border-radius: 10px;
    background: linear-gradient(180deg, #fbf6ec, #e9dfcd);
    box-shadow: inset 0 -3px 0 rgba(0,0,0,.12), inset 0 2px 0 #fff;
    display: flex; align-items: center; justify-content: space-between; padding: 0 18px;
  }
  .cap-legend { font: 400 1.7rem/1 var(--display); letter-spacing: .1em; color: #121110; }
  .cap-sub { font: 700 1.5rem/1 var(--mono); color: #e1261c; }
  .cap:hover .cap-top { background: linear-gradient(180deg, #fff, #f0e6d4); }
  .cap:focus-visible { outline: 3px solid #e1261c; outline-offset: 8px; }
  .cap:active, .cap.down { transform: translateY(8px); box-shadow: 0 2px 0 #0a0908, 0 4px 8px rgba(0,0,0,.5), 0 0 0 2px #e1261c; }
  /* idle: the key gently bobs so it reads as "press me" */
  .cap:not(.down) { animation: bob 2.4s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(2px); } }

  .g-sub { margin: 26px 0 0; font-size: .72rem; letter-spacing: .14em; color: #b9ae9f; }
  .muted { all: unset; cursor: pointer; color: #f3ece0; }
  .muted:hover { color: #e1261c; }
  .muted:focus-visible { outline: 2px solid #e1261c; outline-offset: 3px; }
  .muted kbd {
    display: inline-block; margin-left: 4px; padding: 0 6px; font: 600 .7rem/1.5 var(--mono); color: #f3ece0;
    border: 1.5px solid #f3ece0; border-bottom-width: 3px; border-radius: 4px;
  }

  /* HUD corners, like an anime title card */
  .hud span { position: absolute; z-index: 2; font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: #8d8274; }
  .hud .tl { top: 22px; left: 26px; color: #e1261c; }
  .hud .tr { top: 22px; right: 26px; text-transform: none; }
  .hud .bl { bottom: 22px; left: 26px; }
  .hud .br { bottom: 22px; right: 26px; }
  :global(html.op-play) .hud { display: none; }
  @media (max-width: 640px) { .hud .br, .hud .tr { display: none; } }

  /* halftone vignette over the rays: dots grow towards the edges */
  .halftone {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(circle at 1px 1px, #121110 1.6px, transparent 0) 0 0 / 7px 7px;
    -webkit-mask: radial-gradient(ellipse at center, transparent 35%, #000 85%);
            mask: radial-gradient(ellipse at center, transparent 35%, #000 85%);
  }
  :global(html.op-play) .halftone { display: none; }

  /* the gate's rays sit still and dim; they spin up when the OP starts */
  .rays { position: absolute; inset: -10%; width: 120%; height: 120%; fill: #e1261c; opacity: .16; animation: idle-spin 90s linear infinite; }
  @keyframes idle-spin { to { transform: rotate(360deg); } }

  /* ---- OP sequence (only while html.op-play) ---- */
  .kana, .flash, .card, .skip { display: none; }
  :global(html.op-play) .kana, :global(html.op-play) .card, :global(html.op-play) .skip { display: block; }
  :global(html.op-play) .flash { display: block; }
  :global(html.op-play) .rays { animation: rays-in .3s ease-out forwards, spin 6s linear infinite; }
  @keyframes rays-in { from { opacity: .14; } to { opacity: .9; } }
  @keyframes spin { to { transform: rotate(12deg) scale(1.08); } }

  .kana {
    position: absolute; margin: 0; font: 900 clamp(5rem, 22vw, 18rem)/1 var(--jp); letter-spacing: -0.04em;
    color: #f3ece0; opacity: 0; transform: scale(1.6);
    animation: kana 0.85s cubic-bezier(.2,.9,.2,1) .1s forwards;
  }
  @keyframes kana {
    0% { opacity: 0; transform: scale(1.6); } 25% { opacity: 1; transform: scale(1); }
    80% { opacity: 1; transform: scale(.96); } 100% { opacity: 0; transform: scale(.9); }
  }
  .flash { position: absolute; inset: 0; background: #f3ece0; opacity: 0; animation: flash .22s linear .98s forwards; }
  @keyframes flash { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }

  .card { position: relative; text-align: center; animation: shake .32s steps(2) 1.1s 1; }
  h1 { margin: 0; font-family: var(--display); font-weight: 400; line-height: .86; letter-spacing: .01em; }
  .t1 {
    display: block; font-size: clamp(5rem, 21vw, 17rem); color: #f3ece0; opacity: 0; transform: scale(2.4);
    animation: slam .2s cubic-bezier(.3,1.6,.5,1) 1.08s forwards; text-shadow: 6px 6px 0 #e1261c;
  }
  .t2 {
    display: block; font-size: clamp(2.6rem, 10vw, 8rem); color: #121110; background: #e1261c;
    padding: 0 .25em; margin: .06em auto 0; width: max-content;
    clip-path: inset(0 100% 0 0); animation: wipe .3s cubic-bezier(.7,0,.25,1) 1.45s forwards;
  }
  .ep { margin: 0 0 14px; font-size: .8rem; letter-spacing: .3em; color: #e1261c; opacity: 0; animation: up .3s ease-out 1.75s forwards; }
  .kana-sub { margin: 14px 0 0; font: 900 1.1rem/1 var(--jp); letter-spacing: .35em; opacity: 0; animation: up .3s ease-out 1.9s forwards; }
  .skip { position: absolute; bottom: 24px; right: 28px; margin: 0; font-size: .7rem; letter-spacing: .15em; opacity: .55; }

  @keyframes slam { to { opacity: 1; transform: scale(1); } }
  @keyframes wipe { to { clip-path: inset(0 0 0 0); } }
  @keyframes up { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes shake { 0% { transform: translate(6px, -4px); } 50% { transform: translate(-5px, 4px); } 100% { transform: none; } }

  /* phones and tablets have no keyboard: say "tap" there */
  .on-touch { display: none; }
  @media (hover: none) and (pointer: coarse) {
    .on-keys { display: none; }
    .on-touch { display: inline; }
    .muted kbd { display: none; }
  }
</style>
