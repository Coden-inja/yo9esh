---
// "Now playing" widget for the generated lo-fi loop (src/lib/lofi.ts). Off until the
// visitor presses play or the 9 key; the vinyl spins and the bars follow the real audio.
---
<aside class="player" aria-label="Music player">
  <button class="disc" type="button" aria-label="Play lo-fi music" aria-pressed="false">
    <span class="vinyl" aria-hidden="true"><span class="label">9</span></span>
  </button>
  <div class="meta">
    <p class="now mono">now playing</p>
    <p class="title">lofi.yo9esh</p>
  </div>
  <div class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  <kbd data-key="9" class="hint">9</kbd>
</aside>

<script>
  import { toggle, isPlaying, getAnalyser } from '../lib/lofi';
  import { audio } from '../lib/audio';

  const el = document.querySelector<HTMLElement>('.player')!;
  const btn = el.querySelector<HTMLButtonElement>('.disc')!;
  const bars = [...el.querySelectorAll<HTMLElement>('.eq i')];
  let raf = 0;

  function draw() {
    const a = getAnalyser();
    if (!a || !isPlaying()) { bars.forEach((b) => (b.style.transform = 'scaleY(.15)')); return; }
    const data = new Uint8Array(a.frequencyBinCount);
    a.getByteFrequencyData(data);
    [1, 3, 6, 10, 16].forEach((bin, i) => (bars[i].style.transform = `scaleY(${Math.max(0.12, data[bin] / 255).toFixed(2)})`));
    raf = requestAnimationFrame(draw);
  }

  const nowLabel = el.querySelector<HTMLElement>('.now')!;
  // Some browsers/devices keep audio blocked even after the title-screen key press (e.g. strict
  // autoplay settings). Then the player says so, and the next tap on it unlocks the sound.
  addEventListener('audio:blocked', () => { el.classList.add('blocked'); nowLabel.textContent = 'tap for sound'; });
  btn.addEventListener('click', () => {
    if (el.classList.contains('blocked')) {
      void audio().resume();
      el.classList.remove('blocked'); nowLabel.textContent = 'now playing';
      if (!isPlaying()) toggle();
      return;
    }
    toggle();
  });
  addEventListener('lofi:change', (e) => {
    const on = (e as CustomEvent<boolean>).detail;
    el.classList.toggle('on', on);
    btn.setAttribute('aria-pressed', String(on));
    btn.setAttribute('aria-label', on ? 'Pause lo-fi music' : 'Play lo-fi music');
    cancelAnimationFrame(raf);
    draw();
  });
  // a light pulse on the whole page on every kick, while music plays
  addEventListener('lofi:beat', () => {
    const root = document.documentElement;
    root.classList.add('beat');
    setTimeout(() => root.classList.remove('beat'), 110);
  });
  draw();
</script>

<style>
  .player {
    position: fixed; right: 18px; bottom: 18px; z-index: 40;
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px 10px 10px; max-width: calc(100vw - 36px);
    background: var(--surface); color: var(--ink);
    border: 2px solid var(--ink); border-radius: 6px; box-shadow: 5px 5px 0 var(--ink);
  }
  :global(html.op) .player { visibility: hidden; }
  .disc { all: unset; cursor: pointer; display: grid; place-items: center; border-radius: 50%; }
  .disc:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .vinyl {
    position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background:
      repeating-radial-gradient(circle, #1d1b19 0 2px, #121110 2px 4px);
    box-shadow: inset 0 0 0 1px #000;
  }
  .label {
    display: grid; place-items: center; width: 17px; height: 17px; border-radius: 50%;
    background: var(--accent); color: #f3ece0; font: 400 .62rem/1 var(--display);
  }
  .on .vinyl { animation: spin 1.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .disc::after {
    content: '▶'; position: absolute; font-size: .7rem; color: #f3ece0; text-shadow: 0 0 3px #000;
    transform: translate(13px, 13px); pointer-events: none;
  }
  .on .disc::after { content: '❚❚'; font-size: .55rem; }
  .disc { position: relative; }

  .meta p { margin: 0; line-height: 1.2; }
  .now { font-size: .58rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent-ink); }
  .title { font: 400 1.05rem/1.1 var(--display); letter-spacing: .02em; }
  .sub { font-size: .58rem; color: var(--muted); }

  .eq { display: flex; align-items: flex-end; gap: 3px; height: 26px; }
  .eq i { width: 4px; height: 100%; background: var(--accent); transform-origin: bottom; transform: scaleY(.15); transition: transform .08s linear; }

  .hint {
    display: inline-block; min-width: 1.6em; text-align: center; padding: 1px 5px 0;
    font: 600 .66rem/1.4 var(--mono); color: var(--ink); background: var(--surface);
    border: 1.5px solid var(--ink); border-bottom-width: 3px; border-radius: 4px;
  }
  .hint:global(.down) { transform: translateY(2px); border-bottom-width: 1.5px; background: var(--accent-soft); }

  /* phones: just the spinning record, so it never covers the reading column */
  @media (max-width: 640px) {
    .player { padding: 5px; gap: 0; right: 12px; bottom: 12px; border-radius: 50%; box-shadow: 3px 3px 0 var(--ink); }
    .meta, .eq, .hint { display: none; }
  }
  @media (hover: none) { .hint { display: none; } }
  .blocked { animation: nudge 1.2s ease-in-out infinite; }
  .blocked .now { color: var(--accent); }
  @keyframes nudge { 50% { transform: translateY(-4px); } }
</style>
