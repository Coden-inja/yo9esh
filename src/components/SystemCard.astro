---
// One project: plain summary + results + two highlights up front;
// the architecture diagram and the engineering detail live behind "How it works".
import { Image } from 'astro:assets';
import Flow from './Flow.astro';
import type { System } from '../data/profile';
import agentsfx from '../assets/projects/agentsfx.png';

const images: Record<string, ImageMetadata> = { agentsfx };

interface Props { system: System; index: number; stars: number }
const { system: s, index, stars } = Astro.props;
const fill = (t: string) => t.replaceAll('{stars}', String(stars));
const shot = s.image && images[s.image.key];
---
<article class="sys" id={s.id}>
  <p class="eyebrow"><span class="num">{String(index + 1).padStart(2, '0')}</span> {s.kicker}</p>
  <h3>{s.title}</h3>
  <p class="summary">{s.summary}</p>

  <ul class="metrics">
    {s.metrics.map((m) => (
      <li><strong>{fill(m.value)}</strong><span>{m.label}</span></li>
    ))}
  </ul>

  <ul class="did">
    {s.did.map((d) => <li>{fill(d)}</li>)}
  </ul>

  {shot && (
    <Image src={shot} alt={s.image!.alt} widths={[480, 884]} sizes="(max-width: 720px) 100vw, 884px" class="shot" loading="lazy" />
  )}

  <footer>
    <div class="stack">{s.stack.map((t) => <span class="chip">{t}</span>)}</div>
    {s.links.length > 0 && (
      <div class="links">
        {s.links.map((l) => <a href={l.href}>{l.label} <span aria-hidden="true">↗</span></a>)}
      </div>
    )}
  </footer>

  <details class="how">
    <summary><span class="mono">How it works</span></summary>
    <Flow graph={s.diagram} id={s.id} />
    <dl class:list={['why', { two: !s.tradeoff }]}>
      <div><dt>The problem</dt><dd>{s.constraint}</dd></div>
      <div><dt>What I did</dt><dd>{s.decision}</dd></div>
      {s.tradeoff && <div><dt>The catch</dt><dd>{s.tradeoff}</dd></div>}
    </dl>
  </details>
</article>

<style>
  .sys { padding: clamp(32px, 5vw, 48px) 0; border-bottom: 1px solid var(--line); }
  .sys:first-of-type { padding-top: 0; }
  .num { color: var(--accent-ink); margin-right: 6px; }
  h3 { margin: 10px 0 10px; }
  .summary { margin: 0 0 20px; color: var(--ink-2); max-width: 40em; font-size: 1.05rem; }

  .metrics { list-style: none; margin: 0 0 18px; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .metrics li {
    display: flex; align-items: baseline; gap: 8px;
    padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface);
  }
  .metrics strong { font-family: var(--serif); font-weight: 400; font-size: 1.45rem; line-height: 1; }
  .metrics span { font-size: 0.8rem; color: var(--muted); }

  .did { margin: 0 0 18px; padding-left: 18px; max-width: 46em; color: var(--ink-2); }
  .did li { margin: 6px 0; }
  .did li::marker { color: var(--accent); }

  .shot { width: 100%; height: auto; margin: 4px 0 18px; border-radius: var(--radius); border: 1px solid var(--line); }

  footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 18px; font-size: 0.92rem; font-weight: 500; }

  .how { margin-top: 18px; }
  .how summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.8rem; color: var(--accent-ink); padding: 6px 0;
  }
  .how summary::-webkit-details-marker { display: none; }
  .how summary::before { content: '▸'; transition: transform .15s; }
  .how[open] summary::before { transform: rotate(90deg); }
  .how[open] summary { margin-bottom: 12px; }

  .why { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 3vw, 32px); margin: 20px 0 0; }
  .why.two { grid-template-columns: repeat(2, 1fr); }
  .why dt { font-family: var(--mono); font-size: 0.72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 6px; }
  .why dd { margin: 0; font-size: 0.92rem; color: var(--ink-2); }
  @media (max-width: 820px) { .why, .why.two { grid-template-columns: 1fr; } }
</style>
