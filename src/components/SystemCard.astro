---
import { Image } from 'astro:assets';
import Flow from './Flow.astro';
import type { System } from '../data/profile';
import agentsfx from '../assets/projects/agentsfx.png';

const images: Record<string, ImageMetadata> = { agentsfx };

interface Props { system: System; index: number; stars: number }
const { system: s, index, stars } = Astro.props;
const fill = (t: string) => t.replaceAll('{stars}', String(stars));
const shot = s.image && images[s.image.key];
---
<article class="sys" id={s.id}>
  <header>
    <span class="num mono">{String(index + 1).padStart(2, '0')}</span>
    <div>
      <p class="eyebrow">{s.kicker}</p>
      <h3>{s.title}</h3>
      <p class="summary">{s.summary}</p>
    </div>
  </header>

  <ul class="metrics">
    {s.metrics.map((m) => (
      <li><strong>{fill(m.value)}</strong><span>{m.label}</span></li>
    ))}
  </ul>

  <Flow stages={s.diagram} />

  {shot && (
    <Image src={shot} alt={s.image!.alt} widths={[480, 884]} sizes="(max-width: 720px) 100vw, 884px" class="shot" loading="lazy" />
  )}

  <dl class:list={['why', { two: !s.tradeoff }]}>
    <div><dt>Constraint</dt><dd>{s.constraint}</dd></div>
    <div><dt>Decision</dt><dd>{s.decision}</dd></div>
    {s.tradeoff && <div><dt>Tradeoff</dt><dd>{s.tradeoff}</dd></div>}
  </dl>

  <footer>
    <div class="stack">{s.stack.map((t) => <span class="chip">{t}</span>)}</div>
    {s.links.length > 0 && (
      <div class="links">
        {s.links.map((l) => <a href={l.href}>{l.label} <span aria-hidden="true">↗</span></a>)}
      </div>
    )}
  </footer>
</article>

<style>
  .sys { padding: clamp(40px, 6vw, 64px) 0; border-bottom: 1px solid var(--line); }
  .sys:first-of-type { padding-top: 0; }
  header { display: grid; grid-template-columns: 3.2rem 1fr; gap: 8px; margin-bottom: 28px; }
  .num { font-size: 0.8rem; color: var(--accent-ink); padding-top: 4px; }
  h3 { margin: 8px 0 12px; }
  .summary { margin: 0; color: var(--ink-2); max-width: 40em; }
  @media (max-width: 560px) { header { grid-template-columns: 1fr; } }

  .metrics { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .metrics li { background: var(--bg); padding: 16px 18px; display: flex; flex-direction: column; gap: 2px; }
  .metrics strong { font-family: var(--serif); font-weight: 400; font-size: clamp(1.5rem, 3.6vw, 2.2rem); line-height: 1.1; }
  .metrics span { font-size: 0.78rem; color: var(--muted); }
  @media (max-width: 560px) { .metrics { grid-template-columns: 1fr; } .metrics li { flex-direction: row; align-items: baseline; gap: 12px; } }

  .why { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 3vw, 32px); margin: 28px 0 24px; }
  .shot { width: 100%; height: auto; margin-top: 16px; border-radius: var(--radius); border: 1px solid var(--line); }
  .why.two { grid-template-columns: repeat(2, 1fr); }
  .why dt { font-family: var(--mono); font-size: 0.72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 6px; }
  .why dd { margin: 0; font-size: 0.95rem; color: var(--ink-2); }
  @media (max-width: 820px) { .why, .why.two { grid-template-columns: 1fr; } }

  footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 18px; font-size: 0.92rem; font-weight: 500; }
</style>
