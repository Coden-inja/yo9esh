---
// A project presented like an anime character profile: number, title, power stats,
// enemy / special move / catch, and the system diagram behind "Inspect".
import Flow from './Flow.astro';
import type { System } from '../data/profile';

interface Props { system: System; index: number; stars: number }
const { system: s, index, stars } = Astro.props;
const fill = (t: string) => t.replaceAll('{stars}', String(stars));
const num = String(index + 1).padStart(2, '0');
---
<article class="char" id={s.id} data-card>
  <div class="side">
    <span class="num" aria-hidden="true">{num}</span>
    <p class="kicker mono">{s.kicker}</p>
  </div>

  <div class="main">
    <h3>{s.title}</h3>
    <p class="summary">{s.summary}</p>

    <dl class="stats" aria-label="Power stats">
      {s.metrics.map((m) => (
        <div><dt class="mono">{m.label}</dt><dd data-count>{fill(m.value)}</dd></div>
      ))}
    </dl>

    <div class="moves">
      <div class="move">
        <h4>Problem</h4>
        <p>{s.constraint}</p>
      </div>
      <div class="move">
        <h4>What I did</h4>
        <p>{s.decision}</p>
      </div>
      {s.tradeoff && (
        <div class="move">
          <h4>Tradeoff</h4>
          <p>{s.tradeoff}</p>
        </div>
      )}
    </div>

    <footer>
      <div class="stack">{s.stack.map((t) => <span class="chip">{t}</span>)}</div>
      {s.links.length > 0 && (
        <div class="links">{s.links.map((l) => <a href={l.href}>{l.label} <span aria-hidden="true">↗</span></a>)}</div>
      )}
    </footer>

    <details class="inspect">
      <summary class="mono">Architecture</summary>
      <Flow graph={s.diagram} id={s.id} />
    </details>
  </div>
</article>

<style>
  .char {
    position: relative; display: grid; grid-template-columns: 190px 1fr; gap: 0 36px;
    padding: 34px 36px 30px; margin-bottom: 48px;
    background: var(--surface); border: 2px solid var(--ink); border-radius: 4px;
    box-shadow: 10px 10px 0 var(--ink);
  }
  .char:nth-of-type(even) { box-shadow: 10px 10px 0 var(--accent); }
  .num {
    display: block; font: 400 clamp(5rem, 11vw, 9rem)/.85 var(--display);
    color: transparent; -webkit-text-stroke: 2px var(--accent);
  }
  .kicker { margin: 14px 0 0; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); line-height: 1.6; }

  h3 { margin: 0; font: 400 clamp(2rem, 4.4vw, 3.4rem)/.98 var(--display); letter-spacing: .01em; text-transform: uppercase; }
  .summary { margin: 14px 0 22px; color: var(--ink-2); max-width: 44em; }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 0 0 24px; border: 2px solid var(--ink); }
  .stats div { padding: 12px 16px; border-right: 2px solid var(--ink); }
  .stats div:last-child { border-right: 0; }
  .stats dt { font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .stats dd { margin: 4px 0 0; font: 400 clamp(1.5rem, 2.6vw, 2.3rem)/1 var(--display); color: var(--ink); white-space: nowrap; }
  .stats div:first-child dd { color: var(--accent); }

  .moves { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px 28px; margin-bottom: 22px; }
  h4 { display: flex; align-items: baseline; gap: 10px; margin: 0 0 6px; font: 400 1.15rem/1 var(--display); letter-spacing: .04em; text-transform: uppercase; }
  .k { font: 900 1.25rem/1 var(--jp); color: var(--accent); }
  .moves p { margin: 0; font-size: .95rem; color: var(--ink-2); }

  footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { border-color: var(--ink); color: var(--ink); }
  .links { display: flex; flex-wrap: wrap; gap: 18px; font-size: .92rem; font-weight: 600; }

  .inspect { margin-top: 18px; border-top: 2px dashed var(--line); padding-top: 12px; }
  .inspect summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;
    font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-ink);
  }
  .inspect summary::-webkit-details-marker { display: none; }
  .inspect summary::before { content: '▸'; transition: transform .15s; }
  .inspect[open] summary::before { transform: rotate(90deg); }
  .inspect[open] summary { margin-bottom: 14px; }

  @media (max-width: 820px) {
    .char { grid-template-columns: 1fr; padding: 24px 20px 22px; box-shadow: 6px 6px 0 var(--ink); }
    .char:nth-of-type(even) { box-shadow: 6px 6px 0 var(--accent); }
    .side { display: flex; align-items: flex-end; gap: 14px; margin-bottom: 12px; }
    .num { font-size: 4.2rem; }
    .kicker { margin: 0 0 6px; }
    .stats { grid-template-columns: 1fr; }
    .stats div { border-right: 0; border-bottom: 2px solid var(--ink); display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .stats div:last-child { border-bottom: 0; }
    .stats dd { margin: 0; }
  }
</style>
