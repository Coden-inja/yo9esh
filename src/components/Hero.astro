---
import { Image } from 'astro:assets';
import portrait from '../assets/photos/portrait.png';
import { person } from '../data/profile';

// "Building is the one thing I never get bored of." with the accent word in italics
const [before, after] = person.headline.split('never');
---
<section class="hero wrap">
  <div class="copy">
    <p class="eyebrow">{person.role} · Kolkata</p>
    <h1>{before}<em>never</em>{after}</h1>
    <p class="intro">{person.intro}</p>
    <div class="cta">
      <a class="btn primary" href="#work">See what I’ve built</a>
      <a class="btn" href="/yogesh-kumar-resume.pdf">Resume (PDF)</a>
    </div>
    <p class="now mono">{person.now}</p>
  </div>
  <figure class="photo">
    <Image src={portrait} alt="Yogesh in a yellow kurta at an old Kolkata gate, smiling" widths={[420, 700]} sizes="(max-width: 880px) 70vw, 380px" loading="eager" />
  </figure>
</section>

<style>
  .hero {
    display: grid; grid-template-columns: 1.35fr 0.85fr; gap: clamp(32px, 6vw, 80px);
    align-items: center; padding-top: clamp(32px, 7vw, 80px);
  }
  .hero > * { min-width: 0; }
  @media (max-width: 880px) { .hero { grid-template-columns: 1fr; } .photo { order: -1; max-width: 300px; } }

  h1 { margin: 14px 0 0; font-size: clamp(2.6rem, 6.4vw, 4.6rem); text-wrap: balance; }
  h1 em { color: var(--accent-ink); }
  .intro { font-size: 1.12rem; color: var(--ink-2); max-width: 34em; margin: 24px 0 28px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .now { font-size: 0.78rem; color: var(--muted); margin: 22px 0 0; }

  .photo { margin: 0; }
  .photo img {
    width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 32%;
    border-radius: 20px; border: 1px solid var(--line);
    box-shadow: 0 30px 60px -36px color-mix(in srgb, var(--ink) 55%, transparent);
  }
</style>
