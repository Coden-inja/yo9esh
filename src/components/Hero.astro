---
import { Image } from 'astro:assets';
import avatar from '../assets/photos/avatar-blue.png';
import { person } from '../data/profile';

const rows = [
  { k: 'dns', label: 'dns lookup' },
  { k: 'tcp', label: 'tcp connect' },
  { k: 'tls', label: 'tls handshake' },
  { k: 'ttfb', label: 'first byte' },
  { k: 'download', label: 'download' },
];
---
<section class="hero wrap">
  <div class="copy">
    <p class="hello">
      <Image src={avatar} alt="Yogesh Kumar" width={144} height={144} class="avatar" />
      <span>Hi, I’m <strong>{person.name.split(' ')[0]}</strong>, {person.role.toLowerCase()}.</span>
    </p>
    <h1>I design how the <em>pieces</em> connect.</h1>
    <p class="intro">{person.intro}</p>
    <p class="now mono">{person.now}</p>
    <div class="cta">
      <a class="btn primary" href="#work">See the systems</a>
      <a class="btn" href="/yogesh-kumar-resume.pdf">Resume (PDF)</a>
    </div>
  </div>

  <figure class="trace" aria-label="Live load timing of this page">
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>this page · your connection</span></div>
    <pre class="cmd"><span class="muted">$</span> curl -w <span class="str">"@timing"</span> -so /dev/null {new URL(Astro.site ?? 'https://yo9esh.dev').host}</pre>
    <dl>
      {rows.map((r) => (
        <div class="row" data-k={r.k}>
          <dt>{r.label}</dt>
          <dd><span class="bar"><i></i></span><span class="ms">…</span></dd>
        </div>
      ))}
      <div class="row total" data-k="total">
        <dt>page ready</dt>
        <dd><span class="ms">…</span></dd>
      </div>
    </dl>
    <figcaption>Real numbers from your browser’s Navigation Timing API. A 0 means the connection was reused.</figcaption>
  </figure>
</section>

<script>
  function fmt(n: number) { return n < 1 ? '0 ms' : `${Math.round(n)} ms`; }
  function measure() {
    const [nav] = performance.getEntriesByType('navigation') as PerformanceNavigationTiming[];
    if (!nav) return;
    const tlsStart = nav.secureConnectionStart || nav.connectEnd;
    const t: Record<string, number> = {
      dns: nav.domainLookupEnd - nav.domainLookupStart,
      tcp: tlsStart - nav.connectStart,
      tls: nav.connectEnd - tlsStart,
      ttfb: nav.responseStart - nav.requestStart,
      download: nav.responseEnd - nav.responseStart,
      total: (nav.loadEventEnd || nav.domContentLoadedEventEnd) - nav.startTime,
    };
    const max = Math.max(1, t.dns, t.tcp, t.tls, t.ttfb, t.download);
    for (const [k, v] of Object.entries(t)) {
      const row = document.querySelector<HTMLElement>(`.trace [data-k="${k}"]`);
      if (!row) continue;
      row.querySelector('.ms')!.textContent = fmt(Math.max(0, v));
      const bar = row.querySelector<HTMLElement>('.bar i');
      if (bar) bar.style.width = `${Math.max(2, (Math.max(0, v) / max) * 100)}%`;
    }
  }
  if (document.readyState === 'complete') setTimeout(measure, 0);
  else addEventListener('load', () => setTimeout(measure, 0));
</script>

<style>
  .hero {
    display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(32px, 6vw, 72px);
    align-items: center; padding-top: clamp(40px, 8vw, 96px);
  }
  .hero > * { min-width: 0; }
  @media (max-width: 880px) { .hero { grid-template-columns: 1fr; } }

  .hello { display: flex; align-items: center; gap: 12px; margin: 0 0 22px; color: var(--ink-2); }
  .hello { gap: 16px; font-size: 1.05rem; }
  .avatar { width: 72px; height: 72px; flex: none; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); }
  @media (max-width: 560px) { .avatar { width: 56px; height: 56px; } }
  h1 em { color: var(--accent-ink); }
  .intro { font-size: 1.12rem; color: var(--ink-2); max-width: 36em; margin: 24px 0 12px; }
  .now { font-size: 0.78rem; color: var(--muted); margin: 0 0 28px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }

  .trace {
    margin: 0; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); overflow: hidden; font-family: var(--mono);
    box-shadow: 0 24px 48px -32px color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .chrome { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .chrome i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .chrome span { margin-left: 8px; font-size: 0.68rem; color: var(--muted); }
  .cmd { margin: 0; padding: 14px 16px 6px; font-size: 0.74rem; white-space: pre-wrap; overflow-wrap: break-word; color: var(--ink-2); }
  .str { color: var(--accent-ink); }
  dl { margin: 0; padding: 6px 16px 10px; }
  .row { display: grid; grid-template-columns: 7.5em 1fr; align-items: center; gap: 12px; padding: 5px 0; font-size: 0.74rem; }
  dt { color: var(--muted); }
  dd { margin: 0; display: grid; grid-template-columns: 1fr 4.6em; align-items: center; gap: 10px; }
  .bar { height: 6px; border-radius: 3px; background: var(--bg); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--accent); border-radius: 3px; transition: width .9s cubic-bezier(.2,.8,.2,1); }
  .ms { text-align: right; color: var(--ink); font-variant-numeric: tabular-nums; }
  .total { border-top: 1px dashed var(--line); margin-top: 6px; padding-top: 10px; }
  .total dd { grid-template-columns: 1fr; }
  .total .ms { font-weight: 600; }
  figcaption { padding: 10px 16px 14px; font-size: 0.66rem; line-height: 1.5; color: var(--muted); border-top: 1px solid var(--line); }
</style>
