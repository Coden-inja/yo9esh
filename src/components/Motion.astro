---
// Scroll choreography for the home page: Lenis smooth scroll + GSAP ScrollTrigger.
// Everything is progressive: without JS or with prefers-reduced-motion the page is
// complete and static (html never gets the `motion` class).
---
<div class="progress" aria-hidden="true"><i class="fill"></i><span class="label mono">EP.00</span></div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  const root = document.documentElement;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);
    root.classList.add('motion');

    const lenis = new Lenis({ lerp: 0.1 });
    (window as unknown as { __lenis: Lenis }).__lenis = lenis;
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((t) => lenis.raf(t * 1000));
    gsap.ticker.lagSmoothing(0);

    // hold the page still while the title screen is up
    const syncOp = () => (root.classList.contains('op') ? lenis.stop() : lenis.start());
    new MutationObserver(syncOp).observe(root, { attributes: true, attributeFilter: ['class'] });
    syncOp();

    // ---- 1. hero scroll-out: the name splits, the figure pushes in, the slab tilts ----
    const out = gsap.timeline({ scrollTrigger: { trigger: '.ahero', start: 'top top', end: 'bottom top', scrub: 0.6 } });
    out.to('.ahero .name span:first-child', { xPercent: -45, ease: 'none' }, 0)
      .to('.ahero .name span:last-child', { xPercent: 45, ease: 'none' }, 0)
      .to('.ahero .fig', { yPercent: 8, scale: 1.12, ease: 'none' }, 0)
      .to('.ahero .slab', { rotate: -4, xPercent: 6, ease: 'none' }, 0)
      .to('.ahero .vkana', { yPercent: -60, ease: 'none' }, 0)
      .fromTo('.ahero .ghost', { xPercent: -50 }, { xPercent: -62, ease: 'none' }, 0)
      .to('.ahero .copy > :not(.name)', { opacity: 0, y: -40, stagger: 0.05, ease: 'none' }, 0);

    // ---- 2. episode title cards: letters slam up, kanji drifts at its own speed ----
    $$('[data-ept]').forEach((el) => {
      gsap.timeline({ scrollTrigger: { trigger: el, start: 'top 82%' } })
        .from($$('.c', el), { yPercent: 115, duration: 0.55, ease: 'power4.out', stagger: 0.022 })
        .from(el.querySelector('.num'), { x: -70, opacity: 0, duration: 0.5, ease: 'power3.out' }, 0)
        .from(el.querySelector('.bar'), { scaleX: 0, duration: 0.6, ease: 'power4.inOut' }, 0.1)
        .from(el.querySelector('.jp'), { scale: 1.6, opacity: 0, duration: 0.45, ease: 'back.out(2.2)' }, 0.18);
    });

    // ---- 3. character cards: power stats count up ----
    $$('[data-card]').forEach((card) => {
      // power stats count up
      $$('[data-count]', card).forEach((dd) => {
        const text = dd.textContent ?? '';
        const nums = text.match(/\d[\d,]*/g);
        if (nums?.length !== 1) return; // ranges like "16–80 → 5 GB" stay as written
        const [pre, post] = text.split(nums[0]);
        const target = Number(nums[0].replace(/,/g, ''));
        const fmt = (v: number) => (nums[0].includes(',') ? v.toLocaleString('en-US') : String(v));
        const o = { v: 0 };
        dd.textContent = pre + fmt(0) + post;
        gsap.to(o, { v: target, duration: 1.3, ease: 'power2.out', scrollTrigger: { trigger: card, start: 'top 75%' }, onUpdate: () => (dd.textContent = pre + fmt(Math.round(o.v)) + post) });
      });
    });

    // ---- 4. origin story: pin a full screen and scroll the strip sideways ----
    gsap.matchMedia().add('(min-width: 900px)', () => {
      const section = document.querySelector<HTMLElement>('#story');
      const strip = section?.querySelector<HTMLElement>('.strip');
      const title = section?.querySelector<HTMLElement>('[data-ept]');
      if (!section || !strip || !title) return;
      const setTitle = () => section.style.setProperty('--title-h', title.offsetHeight + 'px');
      setTitle();
      const dist = () => Math.max(0, strip.scrollWidth - document.documentElement.clientWidth);
      gsap.to(strip, {
        x: () => -dist(), ease: 'none',
        scrollTrigger: { trigger: section, start: 'top top', end: () => '+=' + dist(), pin: true, scrub: 0.8, invalidateOnRefresh: true, onRefreshInit: setTitle },
      });
    });

    // ---- 5. credit bands: drift, faster with scroll speed, flip with direction ----
    $$('[data-marquee]').forEach((band) => {
      const track = band.querySelector<HTMLElement>('.track')!;
      const dir = Number(band.dataset.marquee);
      let x = 0, sign = 1;
      gsap.ticker.add((_t, dt) => {
        if (lenis.direction) sign = lenis.direction;
        const speed = 1 + Math.min(10, Math.abs(lenis.velocity) * 0.4);
        const half = track.scrollWidth / 2;
        x = (x + dir * sign * speed * dt * 0.05) % half;
        if (x > 0) x -= half;
        track.style.transform = `translate3d(${x}px,0,0)`;
      });
    });

    // ---- 8. episode progress bar ----
    const fill = document.querySelector<HTMLElement>('.progress .fill')!;
    const label = document.querySelector<HTMLElement>('.progress .label')!;
    ScrollTrigger.create({ start: 0, end: 'max', onUpdate: (s) => (fill.style.transform = `scaleX(${s.progress.toFixed(4)})`) });
    $$('[data-jump]').forEach((sec) => {
      const ep = sec.querySelector('[data-ept] .num')?.textContent ?? 'EP.05';
      ScrollTrigger.create({ trigger: sec, start: 'top 50%', end: 'bottom 50%', onToggle: (s) => { if (s.isActive) label.textContent = ep; } });
    });
    ScrollTrigger.create({ trigger: '.ahero', start: 'top 50%', end: 'bottom 50%', onToggle: (s) => { if (s.isActive) label.textContent = 'EP.00'; } });

    // layout changes that move later triggers
    document.fonts?.ready.then(() => ScrollTrigger.refresh());
    $$('details').forEach((d) => d.addEventListener('toggle', () => ScrollTrigger.refresh()));
  }
</script>

<style>
  .progress { display: none; }
  :global(html.motion) .progress {
    display: block; position: fixed; inset: 0 0 auto 0; z-index: 50; height: 4px; pointer-events: none;
  }
  :global(html.op) .progress { visibility: hidden; }
  .fill { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .label {
    position: absolute; top: 8px; left: 12px; padding: 2px 6px;
    font-size: .62rem; letter-spacing: .18em; color: #f3ece0; background: var(--accent);
  }
  @media (max-width: 640px) { .label { display: none; } }
</style>
