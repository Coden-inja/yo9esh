---
// Contact, as the anime "to be continued" end card + next-episode preview, with the
// final frame anime endings freeze on: Yogesh on stage, mic in hand.
import { Image } from 'astro:assets';
import face from '../assets/hero/yellow-tone.png';
import { person } from '../data/profile';
---
<div class="tbc">
  <div class="copy">
    <p class="preview mono" lang="ja">次回予告 · next episode</p>
    <div class="arrow" data-tbc><span>TO BE CONTINUED</span></div>
    <p class="line">Next episode stars you and me, building something. Say hi.</p>
    <a class="mail" href={`mailto:${person.email}`}>{person.email}</a>
    <ul class="social">
      <li><a href={person.links.github}>GitHub</a></li>
      <li><a href={person.links.linkedin}>LinkedIn</a></li>
      <li><a href={person.links.x}>X</a></li>
      <li><a href={person.links.peerlist}>Peerlist</a></li>
      <li><a href="/yogesh-kumar-resume.pdf">Resume PDF</a></li>
    </ul>
  </div>
  <figure class="face">
    <Image src={face} alt="Yogesh smiling in yellow kurta, drawn in manga screentone" width={320} height={444} densities={[1, 2]} />
    <figcaption lang="ja">つづく</figcaption>
  </figure>
</div>

<style>
  .tbc { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 40px; align-items: center; padding: 20px 0 30px; }
  .preview { margin: 0 0 18px; font-size: .78rem; letter-spacing: .24em; color: var(--accent-ink); }
  /* the arrow-shaped end card: a long left-pointing tag */
  .arrow {
    display: inline-flex; align-items: center; height: clamp(64px, 9vw, 104px);
    padding: 0 clamp(26px, 4vw, 52px) 0 clamp(60px, 8vw, 104px);
    background: var(--ink); color: var(--bg); /* flips with the theme */
    clip-path: polygon(0 50%, clamp(40px, 6vw, 76px) 0, 100% 0, 100% 100%, clamp(40px, 6vw, 76px) 100%);
    max-width: 100%; box-sizing: border-box;
  }
  .arrow span { font: 400 clamp(1.7rem, 5.2vw, 4rem)/1 var(--display); letter-spacing: .04em; white-space: nowrap; }
  .line { margin: 28px 0 10px; font-size: 1.15rem; color: var(--ink-2); }
  /* sans, not a display face: 1 and l must stay distinguishable in an email address */
  .mail { font: 600 clamp(1.3rem, 4vw, 2.1rem)/1.2 var(--sans); letter-spacing: -0.01em; color: var(--accent-ink); overflow-wrap: anywhere; }
  .social { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: .95rem; font-weight: 600; }

  .face { position: relative; margin: 0; width: 320px; }
  .face img { display: block; width: 100%; max-width: 320px; height: auto; border: 3px solid var(--ink); box-shadow: 10px 10px 0 var(--accent); }
  .face figcaption {
    position: absolute; left: -14px; bottom: 18px; padding: 6px 10px;
    background: var(--accent); color: #121110; font: 900 1.4rem/1 var(--jp); letter-spacing: .1em; border: 2px solid #121110;
  }
  @media (max-width: 820px) {
    .tbc { grid-template-columns: 1fr; }
    .face { width: min(280px, 80%); justify-self: center; order: -1; }
  }
</style>
