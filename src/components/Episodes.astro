---
// Origin story laid out like a manga page: short text episodes are stacked two to a
// column, photo episodes get a tall column (photo fills the space under the text), and
// the finale is a full red panel with the line set large. Desktop + motion: the section
// is pinned and the strip scrolls sideways (Motion.astro). Phones: a vertical stack.
import { Image } from 'astro:assets';
import { episodes } from '../data/profile';
// SIH: Yogesh in colour over a screentone backdrop (scripts/color-on-tone.mjs); singing: colour cutout
import sih from '../assets/hero/sih-color.png';
import sing from '../assets/hero/sing-color.png';

type Ep = (typeof episodes)[number] & { photo?: string; special?: boolean; quote?: string; link?: { label: string; href: string } };
const photos = { sih, sing } as const;
const cutouts = new Set(['sing']);
const alts: Record<string, string> = {
  sih: 'Yogesh at the Smart India Hackathon 2024 Grand Finale',
  sing: 'Yogesh singing on stage, mic in hand',
};

// group into page columns: text episodes pair up, photo episodes and the finale stand alone
const columns: { kind: 'pair' | 'photo' | 'finale'; eps: Ep[] }[] = [];
(episodes as Ep[]).forEach((e, i) => {
  const last = i === episodes.length - 1;
  if (last) columns.push({ kind: 'finale', eps: [e] });
  else if (e.photo) columns.push({ kind: 'photo', eps: [e] });
  else {
    const prev = columns.at(-1);
    if (prev?.kind === 'pair' && prev.eps.length < 2) prev.eps.push(e);
    else columns.push({ kind: 'pair', eps: [e] });
  }
});
---
<div class="strip-wrap" data-strip>
  <ol class="strip">
    {columns.map((col) => (
      <li class:list={['col', col.kind]}>
        {col.eps.map((e) => (
          <article class:list={['panel', { special: e.special }]}>
            <header>
              <span class="ep" aria-hidden="true">EP.{e.ep}</span>
              <span class="jp" aria-hidden="true" lang="ja">{e.jp}</span>
            </header>
            <p class="when mono">{e.when}</p>
            <h3>{e.title}</h3>
            <p class="line">
              {e.line}
              {e.link && <> <a href={e.link.href}>{e.link.label} →</a></>}
            </p>
            {e.quote && <p class="quote">“{e.quote}”</p>}
            {e.photo && (
              <div class:list={['shot-wrap', { cutout: cutouts.has(e.photo) }]}>
                <Image src={photos[e.photo as keyof typeof photos]} alt={alts[e.photo]} widths={[400, 800]} sizes="400px" class="shot" />
              </div>
            )}
          </article>
        ))}
      </li>
    ))}
  </ol>
</div>

<style>
  .strip-wrap { overflow-x: auto; padding: 6px 0 22px; }
  :global(html.motion) .strip-wrap { overflow: visible; }
  .strip {
    list-style: none; margin: 0;
    /* first column lines up with the page; the strip runs full-bleed to the right */
    padding: 0 var(--gutter) 0 max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    display: flex; gap: 14px; width: max-content;
    height: var(--strip-h, 520px);
  }
  .col { flex: none; display: flex; flex-direction: column; gap: 14px; height: 100%; }
  .pair { width: 340px; }
  .photo { width: 400px; }
  .finale { width: 480px; }

  .panel {
    position: relative; flex: 1 1 0; min-height: 0; overflow: hidden; box-sizing: border-box;
    display: flex; flex-direction: column; padding: 18px 20px;
    background: var(--surface); border: 2px solid var(--ink);
  }
  header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .ep { font: 400 clamp(1.8rem, 4vh, 2.6rem)/.9 var(--display); color: transparent; -webkit-text-stroke: 1.5px var(--accent); }
  .jp { font: 900 1.25rem/1 var(--jp); letter-spacing: .06em; color: var(--ink); }
  .when { margin: 10px 0 4px; font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; color: var(--accent-ink); }
  h3 { margin: 0 0 8px; font: 400 clamp(1.3rem, 2.8vh, 1.8rem)/.95 var(--display); letter-spacing: .01em; text-transform: uppercase; }
  .line { margin: 0; font-size: .9rem; line-height: 1.5; color: var(--ink-2); }

  /* photo column: the image takes whatever height is left under the text */
  .shot-wrap { flex: 1 1 auto; min-height: 120px; margin-top: 14px; overflow: hidden; border: 2px solid var(--ink); }
  .shot { width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; display: block; }
  /* cutout: no frame, the figure stands on the panel itself */
  .shot-wrap.cutout { border: 0; margin-bottom: -18px; }
  .cutout .shot { object-fit: contain; object-position: 50% 100%; }

  /* special episode: inverted ink panel */
  .special { background: var(--ink); border-color: var(--ink); }
  .special .ep { -webkit-text-stroke-color: var(--bg); }
  .special .jp, .special .line, .special h3 { color: var(--bg); }

  /* finale: full red panel, the line set large and anchored to the bottom */
  .finale .panel { background: var(--accent); border-color: #121110; color: #121110; padding: 22px 26px; }
  .finale .ep { -webkit-text-stroke-color: #121110; }
  .finale .jp, .finale .when, .finale .line { color: #121110; }
  .finale .quote {
    margin: auto 0 0; padding-top: 16px;
    font: 400 clamp(2.2rem, 5.6vh, 3.6rem)/.95 var(--display); letter-spacing: .01em; text-transform: uppercase; color: #121110;
  }

  /* short laptop screens: tighten so a pair of text panels always fits half the strip */
  @media (max-height: 760px) {
    .panel { padding: 14px 16px; }
    .line { font-size: .84rem; line-height: 1.45; }
  }

  @media (max-width: 720px) {
    .strip-wrap { overflow: visible; }
    .strip { flex-direction: column; width: auto; height: auto; padding: 0 var(--gutter); }
    .col, .pair, .photo, .finale { display: contents; }
    .panel { flex: none; }
    .shot-wrap { height: 300px; flex: none; }
  }
</style>
