---
import '../styles/global.css';
import { person } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  bare?: boolean; // no nav/footer (resume print page)
}
const {
  title = `${person.name} · ${person.role}`,
  description = `${person.name}: ${person.role.toLowerCase()} who designs how products and systems connect.`,
  bare = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#faf7f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131210" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    {!bare && (
      <header class="nav wrap">
        <a href="/" class="mark" aria-label="Home">yo<span>9</span>esh</a>
        <nav>
          <a href="/#work">Work</a>
          <a href="/#notes">Notes</a>
          <a href="/#about">About</a>
          <a href="/resume">Resume</a>
          <button class="theme" type="button" aria-label="Toggle dark mode">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"/></svg>
          </button>
        </nav>
      </header>
    )}
    <main><slot /></main>
    {!bare && (
      <footer class="wrap foot">
        <span>© {new Date().getFullYear()} {person.name}</span>
        <span class="mono">Built with Astro · no trackers · <a href="https://github.com/Coden-inja/yo9esh">source</a></span>
      </footer>
    )}
    <script is:inline>
      document.querySelector('.theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 22px; padding-bottom: 22px; gap: 16px;
  }
  .mark { font-family: var(--mono); font-weight: 600; font-size: 1rem; text-decoration: none; letter-spacing: -0.02em; }
  .mark span { color: var(--accent-ink); }
  nav { display: flex; align-items: center; gap: clamp(12px, 3vw, 28px); font-size: 0.92rem; }
  nav a { text-decoration: none; color: var(--ink-2); }
  nav a:hover { color: var(--ink); }
  .theme {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    border: 1px solid var(--line); background: transparent; color: var(--ink-2); cursor: pointer;
  }
  .theme:hover { color: var(--ink); border-color: var(--ink-2); }
  @media (max-width: 480px) { nav a[href='/#notes'] { display: none; } }
  .foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px;
    padding-top: 28px; padding-bottom: 40px; border-top: 1px solid var(--line);
    font-size: 0.82rem; color: var(--muted);
  }
</style>
